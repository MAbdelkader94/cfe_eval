#!/bin/bash
# 05_merge.job - step 5, merge the per-gage results into the final tables (one task)
# Submit with jobs/submit_all.sh (it sets the log folder, the hold chain and the array range).

#$ -N cfe_05_merge
#$ -q IFC
#$ -pe smp 1
#$ -cwd
#$ -j y
#$ -m a
#$ -r y

REPO="${SGE_O_WORKDIR:-$(pwd)}"
source "${REPO}/jobs/env.sh"
cd "${REPO}" || exit 1

[ -f "${REPO}/scripts/05_merge.py" ] || { echo "ERROR: submit from the repository root (script not found in ${REPO})"; exit 1; }
[ -f "${CFE_DATA_ROOT}/organized/manifest.json" ] || { echo "ERROR: step 1 has not finished: ${CFE_DATA_ROOT}/organized/manifest.json missing"; exit 1; }

echo "Task ${SGE_TASK_ID:-single}  Host: $(hostname)  Slots: ${NSLOTS:-1}"
echo "Data root: ${CFE_DATA_ROOT}"
echo "Started: $(date)"

python scripts/05_merge.py 
STATUS=$?

echo "Finished: $(date)"
echo "Exit code: ${STATUS}"
exit ${STATUS}
